{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopee-tracker",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-07",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "shopee.phamkhanhminhman.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shopee-tracker",
      "database_id": "acf85f09-7fd0-46bb-a354-7ba94806a8b6",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_PUBLIC_URL": "https://shopee.phamkhanhminhman.com"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
